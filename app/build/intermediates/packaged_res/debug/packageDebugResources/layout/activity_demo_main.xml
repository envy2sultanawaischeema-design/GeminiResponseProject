<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#FAFAFA">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Gemini Demo"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#1A1A2E"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Button 1: Sirf open karo — no result -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenOnly"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Open Gemini Chat"
        android:textSize="16sp"
        app:cornerRadius="12dp"
        app:backgroundTint="#4CAF50"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"/>

    <TextView
        android:id="@+id/tvHint1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="↑ Sirf chat screen kholega, response wapas nahi aayega"
        android:textSize="12sp"
        android:textColor="#888"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/btnOpenOnly"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Button 2: Open + result wapas lo -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGetResult"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Get Response from Gemini"
        android:textSize="16sp"
        app:cornerRadius="12dp"
        app:backgroundTint="#2196F3"
        app:layout_constraintTop_toBottomOf="@id/tvHint1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"/>

    <TextView
        android:id="@+id/tvHint2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="↑ Chat karo, pehla response neeche dikhega"
        android:textSize="12sp"
        android:textColor="#888"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/btnGetResult"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Response Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardResponse"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/tvHint2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gemini ka Response:"
                android:textStyle="bold"
                android:textColor="#2196F3"
                android:textSize="14sp"/>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvResponse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#333"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp"/>

            </ScrollView>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
